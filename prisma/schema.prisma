generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  userType     String   @map("user_type") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  musicianProfile MusicianProfile?
  bandProfile     BandProfile?

  @@map("users")
}

model MusicianProfile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  stageName     String?  @map("stage_name") @db.VarChar(150)
  bio           String?
  baseCity      String   @map("base_city") @db.VarChar(100)
  baseCountry   String   @map("base_country") @db.VarChar(100)
  hasPassport   Boolean  @default(false) @map("has_passport")
  websiteUrl    String?  @map("website_url") @db.VarChar(255)
  videoReelUrl  String?  @map("video_reel_url") @db.VarChar(255)
  hourlyRateUsd Decimal? @map("hourly_rate_usd") @db.Decimal(10, 2)
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruments MusicianInstrument[]
  applications Application[]

  @@map("musician_profiles")
}

model BandProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  bandName   String   @map("band_name") @db.VarChar(150)
  genre      String?  @db.VarChar(100)
  bio        String?
  websiteUrl String?  @map("website_url") @db.VarChar(255)
  logoUrl    String?  @map("logo_url") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tours Tour[]
  gigs  Gig[]

  @@map("band_profiles")
}

model Instrument {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  musicianInstruments MusicianInstrument[]
  gigListings         GigListing[]

  @@map("instruments")
}

model MusicianInstrument {
  musicianId        String @map("musician_id") @db.Uuid
  instrumentId      Int    @map("instrument_id")
  proficiencyLevel  String @map("proficiency_level") @db.VarChar(50)
  isPrimary         Boolean @default(false) @map("is_primary")

  musician   MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  instrument Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@id([musicianId, instrumentId])
  @@index([instrumentId], map: "musician_instruments_instrument_id_idx")
  @@map("musician_instruments")
}

model Tour {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bandId      String   @map("band_id") @db.Uuid
  title       String   @db.VarChar(150)
  description String?
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  band        BandProfile  @relation(fields: [bandId], references: [id], onDelete: Cascade)
  gigs        Gig[]
  gigListings GigListing[]

  @@index([bandId], map: "tours_band_id_idx")
  @@map("tours")
}

model Gig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tourId    String?  @map("tour_id") @db.Uuid
  bandId    String   @map("band_id") @db.Uuid
  venueName String   @map("venue_name") @db.VarChar(150)
  city      String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  gigDate   DateTime @map("gig_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tour        Tour?        @relation(fields: [tourId], references: [id], onDelete: SetNull)
  band        BandProfile  @relation(fields: [bandId], references: [id], onDelete: Cascade)
  gigListings GigListing[]

  @@index([bandId], map: "gigs_band_id_idx")
  @@index([tourId], map: "gigs_tour_id_idx")
  @@index([gigDate], map: "gigs_gig_date_idx")
  @@map("gigs")
}

model GigListing {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tourId            String?  @map("tour_id") @db.Uuid
  gigId             String?  @map("gig_id") @db.Uuid
  instrumentNeeded  Int      @map("instrument_needed")
  payRateUsd        Decimal  @map("pay_rate_usd") @db.Decimal(10, 2)
  payType           String   @map("pay_type") @db.VarChar(50)
  description       String
  status            String   @default("open") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tour       Tour?         @relation(fields: [tourId], references: [id], onDelete: Cascade)
  gig        Gig?          @relation(fields: [gigId], references: [id], onDelete: Cascade)
  instrument Instrument    @relation(fields: [instrumentNeeded], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([tourId], map: "gig_listings_tour_id_idx")
  @@index([gigId], map: "gig_listings_gig_id_idx")
  @@index([instrumentNeeded], map: "gig_listings_instrument_needed_idx")
  @@index([status], map: "gig_listings_status_idx")
  @@map("gig_listings")
}

model Application {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId    String   @map("listing_id") @db.Uuid
  musicianId   String   @map("musician_id") @db.Uuid
  pitchMessage String?  @map("pitch_message")
  status       String   @default("pending") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing  GigListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  musician MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  @@unique([listingId, musicianId])
  @@index([musicianId], map: "applications_musician_id_idx")
  @@index([status], map: "applications_status_idx")
  @@map("applications")
}
